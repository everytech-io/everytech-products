# Copy to .env.local for local dev. Every var below is one the app actually reads
# (grep for process.env across src/ if you add a new one — keep this file honest).

# Canonical origin for metadata/OG/JSON-LD/sitemaps (src/lib/site.ts). Leave unset
# in production; only override for preview/staging deploys that shouldn't claim
# the production canonical.
NEXT_PUBLIC_SITE_URL=https://apps.everytech.io

# Direct Postgres connection string — backs the FranchiseIQ data (fiq_* tables), the
# AppLeap waitlist (appleap_waitlist) and the course signup list (course_followers).
# Takes priority over SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY below when both are set.
# Supabase's pooled connection string works here too.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Supabase project + service-role key, used only if DATABASE_URL is absent. The
# service-role key bypasses RLS — server-only, never expose it to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Port Railway/`npm run start` binds to. Railway sets this itself in production;
# only needed locally if you want something other than the 3000 default.
PORT=3000
